# Local SQLite edition needs no environment variables.
# For cloud development, copy to .env.local and fill public project settings.
NEXT_PUBLIC_STORAGE_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Use /travel-plan-central-america for the default GitHub Pages project URL.
NEXT_PUBLIC_BASE_PATH=/travel-plan-central-america
# Never put a service-role key, database password or sb_secret_ key here.
